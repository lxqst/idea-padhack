{
    "keyboard_name": "idpad",
    "manufacturer": "Liam",
    "maintainer": "Liam",
    "url": "https://github.com/lxqst/idea-padhack/tree/main",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x1D00",
        "device_version": "1.0.0"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": ["GP8", "GP9"],
        "rows": ["GP27", "GP28", "GP29"]
    },
    "features": {
        "extrakey": true,
        "encoder": true,
        "oled": true
    },
    "encoder": {
        "rotary": [
            { "pin_a": "GP3", "pin_b": "GP0" }
        ]
    },
    "build": {
        "lto": true
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                { "matrix": [2, 0], "x": 0, "y": 0 },
                { "matrix": [1, 0], "x": 1, "y": 0 },
                { "matrix": [0, 0], "x": 2, "y": 0 },
                { "matrix": [0, 1], "x": 3, "y": 1 },
                { "matrix": [2, 1], "x": 4, "y": 1 },
                { "matrix": [1, 1], "x": 4, "y": 0 }
            ]
        }
    }
}
